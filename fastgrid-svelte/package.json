{
  "name": "fastgrid-svelte",
  "version": "3.3.2",
  "description": "Official Svelte wrapper for FastGrid and FastSheet, a high-performance TypeScript data grid and web spreadsheet for large datasets, virtual scrolling, tree data, pivoting, XLSX and AI.",
  "keywords": [
    "fastgrid",
    "fast-grid",
    "fastsheet",
    "fast-sheet",
    "svelte",
    "svelte-grid",
    "svelte grid",
    "svelte-data-grid",
    "svelte data grid",
    "svelte-datagrid",
    "svelte-table",
    "svelte table",
    "svelte-data-table",
    "svelte-datatable",
    "svelte-tree-grid",
    "svelte tree grid",
    "svelte-spreadsheet",
    "svelte spreadsheet",
    "svelte-component",
    "svelte-library",
    "svelte-wrapper",
    "svelte-standalone",
    "standalone-component",
    "typescript",
    "typescript-grid",
    "data-grid",
    "data grid",
    "datagrid",
    "data-table",
    "datatable",
    "tree-grid",
    "tree grid",
    "hierarchical-grid",
    "hierarchical-data",
    "spreadsheet",
    "web-spreadsheet",
    "javascript-spreadsheet",
    "excel-like-grid",
    "xlsx",
    "xlsx-editor",
    "csv",
    "virtual-scrolling",
    "virtual-scroll",
    "virtualization",
    "large-datasets",
    "large-data-grid",
    "big-data-grid",
    "million-rows",
    "million-columns",
    "high-performance-grid",
    "editable-grid",
    "cell-editing",
    "sorting",
    "filtering",
    "grouping",
    "aggregation",
    "pivot-grid",
    "pivot-table",
    "tree-table",
    "formulas",
    "excel-formulas",
    "conditional-formatting",
    "copy-paste",
    "xlsx-export",
    "csv-export",
    "pdf-export",
    "enterprise-grid",
    "enterprise-data-grid",
    "ai-grid",
    "ai-data-grid",
    "ai-spreadsheet",
    "ai-assisted-grid",
    "openai-integration"
  ],
  "author": {
    "name": "COQsoft",
    "email": "support@coqsoft.com",
    "url": "https://www.treegrid.com"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://www.treegrid.com/FDoc/FastGridSvelte.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coqsoft/fastgrid-frameworks.git",
    "directory": "fastgrid-svelte"
  },
  "bugs": {
    "url": "https://github.com/coqsoft/fastgrid-frameworks/issues"
  },
  "type": "module",
  "main": "./dist/fastgrid-svelte.cjs",
  "module": "./dist/fastgrid-svelte.js",
  "types": "./types/fastgrid-svelte.d.ts",
  "sideEffects": [
    "**/FGridE.js",
    "./dist/fastgrid-svelte.js",
    "./dist/fastgrid-svelte.cjs"
  ],
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "latest",
    "svelte": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "scripts": {
    "generate:api": "node scripts/generate-fastgrid-svelte-api.mjs",
    "build": "npm run generate:api && vite build",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "import": "./dist/fastgrid-svelte.js",
      "require": "./dist/fastgrid-svelte.cjs",
      "types": "./types/fastgrid-svelte.d.ts"
    },
    "./registered": {
      "import": "./dist/registered.js",
      "require": "./dist/registered.cjs",
      "types": "./types/fastgrid-svelte.d.ts"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE.md",
    "NOTICE.md"
  ]
}

  "homepage": "https://www.treegrid.com/FDoc/FastGridReact.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coqsoft/fastgrid-frameworks.git",
    "directory": "fastgrid-react"
  },
  "bugs": {
    "url": "https://github.com/coqsoft/fastgrid-frameworks/issues"
  },
  "type": "module",
  "main": "./dist/fastgrid-react.cjs",
  "module": "./dist/fastgrid-react.js",
  "types": "./types/fastgrid-react.d.ts",
  "sideEffects": [
    "**/FGridE.js",
    "./dist/fastgrid-react.js",
    "./dist/fastgrid-react.cjs"
  ],
  "peerDependencies": {
    "react": ">=16.14",
    "react-dom": ">=16.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "scripts": {
    "build": "vite build",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "import": "./dist/fastgrid-react.js",
      "require": "./dist/fastgrid-react.cjs",
      "types": "./types/fastgrid-react.d.ts"
    },
    "./registered": {
      "import": "./dist/registered.js",
      "require": "./dist/registered.cjs",
      "types": "./types/fastgrid-react.d.ts"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE.md",
    "NOTICE.md"
  ]
}

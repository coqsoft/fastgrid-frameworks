{
  "name": "fastgrid-frameworks",
  "version": "3.2.2",
  "private": true,
  "description": "Official open-source framework wrappers, project generators, examples and tutorials for the FastGrid data grid and FastSheet web spreadsheet.",
  "keywords": [
    "fastgrid",
    "fast-grid",
    "fast grid",
    "fastsheet",
    "fast-sheet",
    "fast sheet",
    "treegrid",
    "data-grid",
    "data grid",
    "datagrid",
    "data-table",
    "data table",
    "datatable",
    "javascript-grid",
    "javascript-data-grid",
    "typescript-grid",
    "web-grid",
    "tree-grid",
    "tree grid",
    "hierarchical-grid",
    "hierarchical-data",
    "spreadsheet",
    "web-spreadsheet",
    "javascript-spreadsheet",
    "typescript-spreadsheet",
    "excel-like-grid",
    "excel-like-spreadsheet",
    "xlsx",
    "xlsx-viewer",
    "xlsx-editor",
    "csv",
    "virtual-scrolling",
    "virtual-scroll",
    "virtualization",
    "large-datasets",
    "large-data",
    "big-data-grid",
    "million-rows",
    "million-columns",
    "high-performance-grid",
    "editable-grid",
    "cell-editing",
    "inline-editing",
    "sorting",
    "filtering",
    "grouping",
    "aggregation",
    "pivot-grid",
    "pivot-table",
    "tree-table",
    "formulas",
    "excel-formulas",
    "conditional-formatting",
    "copy-paste",
    "import-export",
    "xlsx-export",
    "csv-export",
    "pdf-export",
    "typescript",
    "javascript",
    "frontend",
    "browser-component",
    "ui-component",
    "enterprise-grid",
    "enterprise-data-grid",
    "ai-grid",
    "ai-data-grid",
    "ai-spreadsheet",
    "ai-assisted-grid",
    "openai-integration",
    "angular",
    "angular-grid",
    "react",
    "react-grid",
    "vue",
    "vue-grid",
    "svelte",
    "svelte-grid",
    "vanilla-javascript",
    "framework-wrapper",
    "project-generator",
    "starter-template",
    "scaffolding",
    "examples",
    "tutorials"
  ],
  "homepage": "https://www.treegrid.com/FastGrid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coqsoft/fastgrid-frameworks.git"
  },
  "bugs": {
    "url": "https://github.com/coqsoft/fastgrid-frameworks/issues"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22.22.3"
  },
  "workspaces": [
    "./fastgrid-react",
    "./fastgrid-vue",
    "./fastgrid-angular",
    "./fastgrid-svelte",
    "./create-*",
    "./create-*/*",
    "./create-*/*/*",
    "./create-*/*/*/*"
  ],
  "scripts": {
    "react-quick-start": "npm run dev -w create-fastgrid-react/quick-start",
    "react-quick-start-typescript": "npm run dev -w create-fastgrid-react/quick-start-typescript",
    "react-tutorials": "npm run dev -w create-fastgrid-react/tutorials",
    "react-examples": "start \"server\" /b npm run dev -w create-fastgrid-react/examples/server & npm run dev -w create-fastgrid-react/examples",
    "react-client": "npm run dev -w create-fastgrid-react/examples",
    "react-server": "npm run dev -w create-fastgrid-react/examples/server",
    "build-react": "npm run build -w fastgrid-react",
    "pack-react": "npm pack -w fastgrid-react --dry-run",
    "pack-create-react": "npm pack -w create-fastgrid-react --dry-run",
    "copy-react": "node create-fastgrid-react/create-fastgrid-react.js test1",
    "vue-quick-start": "npm run dev -w create-fastgrid-vue/quick-start",
    "vue-quick-start-typescript": "npm run dev -w create-fastgrid-vue/quick-start-typescript",
    "vue-tutorials": "npm run dev -w create-fastgrid-vue/tutorials",
    "vue-examples": "start \"server\" /b npm run dev -w create-fastgrid-vue/examples/server & npm run dev -w create-fastgrid-vue/examples",
    "build-vue": "npm run build -w fastgrid-vue",
    "pack-vue": "npm pack -w fastgrid-vue --dry-run",
    "pack-create-vue": "npm pack -w create-fastgrid-vue --dry-run",
    "copy-vue": "node create-fastgrid-vue/create-fastgrid-vue.js test1",
    "angular-quick-start": "npm run dev -w create-fastgrid-angular/quick-start",
    "angular-quick-start-typescript": "npm run dev -w create-fastgrid-angular/quick-start-typescript",
    "angular-tutorials": "npm run dev -w create-fastgrid-angular/tutorials",
    "angular-examples": "start \"server\" /b npm run dev -w create-fastgrid-angular/examples/server & npm run dev -w create-fastgrid-angular/examples",
    "angular-client": "npm run dev -w create-fastgrid-angular/examples",
    "angular-server": "npm run dev -w create-fastgrid-angular/examples/server",
    "build-angular": "npm run build -w fastgrid-angular",
    "pack-angular": "npm pack -w fastgrid-angular --dry-run",
    "pack-create-angular": "npm pack -w create-fastgrid-angular --dry-run",
    "copy-angular": "node create-fastgrid-angular/create-fastgrid-angular.js test1",
    "svelte-quick-start": "npm run dev -w create-fastgrid-svelte/quick-start",
    "svelte-quick-start-typescript": "npm run dev -w create-fastgrid-svelte/quick-start-typescript",
    "svelte-tutorials": "npm run dev -w create-fastgrid-svelte/tutorials",
    "svelte-examples": "start \"server\" /b npm run dev -w create-fastgrid-svelte/examples/server & npm run dev -w create-fastgrid-svelte/examples",
    "build-svelte": "npm run build -w fastgrid-svelte",
    "pack-svelte": "npm pack -w fastgrid-svelte --dry-run",
    "pack-create-svelte": "npm pack -w create-fastgrid-svelte --dry-run",
    "copy-svelte": "node create-fastgrid-svelte/create-fastgrid-svelte.js test1",
    "copy-html": "node create-fastgrid-html/create-fastgrid-html.js test1",
    "copy": "node create-fastgrid/create-fastgrid.mjs test1"
  },
  "devDependencies": {
    "vue-router": "latest"
  },
  "allowScripts": {
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "@parcel/watcher": true,
    "puppeteer": true,
    "better-sqlite3": true
  }
}

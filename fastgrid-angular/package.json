{
   "name": "fastgrid-angular",
   "version": "3.2.2",
   "description": "Official Angular wrapper for FastGrid and FastSheet, a high-performance TypeScript data grid and web spreadsheet for large datasets, virtual scrolling, tree data, pivoting, XLSX and AI.",
   "keywords": [
      "fastgrid",
      "fast-grid",
      "fastsheet",
      "fast-sheet",
      "angular",
      "angular-grid",
      "angular grid",
      "angular-data-grid",
      "angular data grid",
      "angular-datagrid",
      "angular-table",

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": [
    "core/**/*.ts",
    "trial/**/*.ts",
    "trial/**/*.d.ts",
    "registered/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}